# Backend configuration. Defaults shown below.
TEXTORIGIN_MODEL_PATH=models/roberta-classifier
TEXTORIGIN_FEATURE_THRESHOLDS_PATH=models/feature-thresholds.json
TEXTORIGIN_CORS_ORIGINS=http://localhost:3000
TEXTORIGIN_SIMILARITY_THRESHOLD=0.85
TEXTORIGIN_MIN_SIMILARITY_THRESHOLD=0.80
TEXTORIGIN_MAX_CONCURRENT_INFERENCES=1
TEXTORIGIN_INFERENCE_WAIT_SECONDS=5
TEXTORIGIN_INCLUDE_SIGNALS=false
TEXTORIGIN_LOG_LEVEL=INFO
# Optional DeepSeek polish stage. Leave unset for local-only rewriting.
DEEPSEEK_API_KEY=
TEXTORIGIN_DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXTORIGIN_DEEPSEEK_MODEL=deepseek-chat
TEXTORIGIN_DEEPSEEK_TIMEOUT_SECONDS=60

# Transient single-process jobs; no disk persistence.
TEXTORIGIN_JOB_QUEUE_SIZE=4
TEXTORIGIN_JOB_RETAINED_COUNT=32
TEXTORIGIN_JOB_TTL_SECONDS=600
TEXTORIGIN_JOB_MEMORY_BYTES=33554432
TEXTORIGIN_CLASSIFIER_BATCH_SIZE=2
