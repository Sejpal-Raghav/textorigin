# Backend configuration. Defaults shown below.
TEXTORIGIN_MODEL_PATH=models/roberta-classifier
TEXTORIGIN_FEATURE_THRESHOLDS_PATH=models/feature-thresholds.json
TEXTORIGIN_CORS_ORIGINS=http://localhost:3000
TEXTORIGIN_MAX_TEXT_CHARS=10000
TEXTORIGIN_SIMILARITY_THRESHOLD=0.85
TEXTORIGIN_MIN_SIMILARITY_THRESHOLD=0.80
TEXTORIGIN_MAX_CONCURRENT_INFERENCES=1
TEXTORIGIN_INFERENCE_WAIT_SECONDS=5
TEXTORIGIN_INCLUDE_SIGNALS=false
TEXTORIGIN_LOG_LEVEL=INFO
OLLAMA_HOST=http://localhost:11434
TEXTORIGIN_OLLAMA_MODEL=llama3:8b-instruct
TEXTORIGIN_OLLAMA_TIMEOUT_SECONDS=60
